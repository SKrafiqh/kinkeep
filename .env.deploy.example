# Copy to .env.deploy (git-ignored) and fill in. scripts/deploy.sh reads it and stores the
# keys in Secret Manager; they are never printed. Do not paste these values into chat.

# Google Cloud / Firebase project id (not the display name), and the region to run in.
PROJECT_ID=
REGION=asia-south1

# Adaption Labs API key (Adaption app: Settings, then API keys). Model is optional.
AI_API_KEY=
AI_MODEL=gemma-4-31b-it

# Gmail account that sends reminders, and its 16-character app password
# (Google Account > Security > 2-Step Verification > App passwords).
GMAIL_USER=
GMAIL_APP_PASSWORD=
