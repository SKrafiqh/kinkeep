# Copy to .env.local for local development. Never commit real values.
# Full descriptions: docs/SETUP.md section 2.

APP_URL=http://localhost:3000

# Data: "memory" keeps everything in the server process (local dev, tests),
# "firestore" uses the real database. Production defaults to firestore.
DATA_STORE=memory
GOOGLE_CLOUD_PROJECT=
# Only for hosts without a Google identity (Vercel, Render...): the service-account JSON on one line.
# On Cloud Run leave it empty; the runtime service account is used.
FIREBASE_SERVICE_ACCOUNT=

# AI for the visit brief: Adaption Labs (https://docs.adaptionlabs.ai). Leave the key empty
# and the brief is built without AI from the same records.
AI_API_KEY=
AI_MODEL=gemma-4-31b-it
AI_BASE_URL=https://api.prod.adaptionlabs.ai

# Email: "console" logs emails locally, "gmail" sends through Gmail SMTP
EMAIL_PROVIDER=console
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Signing secrets: generate each with `openssl rand -base64 48`
SESSION_SECRET=
PASSCODE_PEPPER=
ACTION_TOKEN_SECRET=

# Reminder engine caller: Cloud Scheduler's service account (OIDC), or a shared secret
# sent as the x-cron-secret header by any other scheduler.
CRON_SERVICE_ACCOUNT=
CRON_SECRET=
